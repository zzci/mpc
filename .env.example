# mcp-wallet 环境变量示例(占位)。复制为 .env 后填入真实值;.env 已被 git 忽略。
#
# 配置三源(Traefik 式,统一键空间,用户裁定 2026-05-19):
#   内置默认 < 配置文件(server.yaml)< 环境变量 < CLI 参数
# 完整带注释字段见 server.example.yaml;此处仅列运维通常经 env 注入的项。
#
# 环境变量约定:`MPC_` + 大写点分键,嵌套与键内 `_` 一律单 `_`。
# 任一配置键均可这样覆盖(如 MPC_LOG_LEVEL、MPC_RELAY_ENABLE、
# MPC_COORD_HTTP_LISTEN);名由 schema 生成后精确匹配,不解析 env 名。
# 值可为字面量或 env:/file: 引用;secret 推荐经 env 注入而非写入提交的文件。

# ── relay 角色 ────────────────────────────────────────────────────────────
# private-network 32B swarm key(secret)
MPC_RELAY_PNET_PSK=

# ── coord 角色 ────────────────────────────────────────────────────────────
# SQLite 持久化连接串(secret)
MPC_COORD_DB_DSN=
# 外部业务服务 API Key(鉴权固定 api_key,恒必填,secret)
MPC_COORD_EXTERNAL_API_KEY=
# 结果回传 webhook URL(结果固定 webhook,恒必填)
MPC_COORD_EXTERNAL_RESULT_WEBHOOK=
# 单一固定通知 webhook(coord 仅 POST 通知事件;FCM/APNS 等由外部通知渠道处理)
MPC_COORD_NOTIFY_WEBHOOK=

# ── dev/test 专用 ─────────────────────────────────────────────────────────
# 仅当 coord.db.encryption.enable=false 时必须显式确认非生产,否则启动
# fail-closed 拒绝;生产/release 绝不设置(production iron-law guardrail,
# database.md §7.1)。
# ALLOW_INSECURE_DB=1

# 注:DB 解锁口令是绝对例外 —— 不得进 .env / 配置文件 / CLI / KMS,
# 仅经 admin-api 解锁交互在内存提供、重锁即清零(server.md C9b、database.md §7)。
