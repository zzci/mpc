# mcp-wallet environment variable example (placeholders). Copy to .env and fill
# in real values; .env is git-ignored.
#
# This file enumerates EVERY config leaf key (1:1 with server.example.yaml and
# the server.md parameter table); a coverage test fails if they ever diverge
# from the config.go schema.
#
# Three config sources (Traefik-style, one unified key space):
#   built-in default < config file (server.yaml) < environment < CLI flags
#
# Env convention: `MPC_` + the upper-cased dotted key; the nesting separator
# and any intra-key `_` both collapse to a single `_`. Names are generated
# from the schema and matched exactly, never parsed from the env name.
#
# CLI equivalent of every key below: `--<dotted.key>=<value>`
# (e.g. --log.level=info, --relay.enable=true, --coord.http.listen=:8080);
# CLI is the highest-priority source.
#
# Values may be literals or env:/file: references; secrets are best injected
# via env rather than written into a committed file. `[]string` keys
# (MPC_RELAY_LISTEN, MPC_RELAY_TOKEN_VERIFY_GROUP_PUBKEYS) take comma-separated
# multi-values (e.g. a,b,c). Empty placeholders below are required only when
# their role is enabled (fail-fast otherwise).

# -- log -------------------------------------------------------------------
# log level: debug | info | warn | error
MPC_LOG_LEVEL=
# log format: json | text
MPC_LOG_FORMAT=

# -- metrics ---------------------------------------------------------------
# health-check + Prometheus metrics listen address (no payload data)
MPC_METRICS_LISTEN=

# -- relay role ------------------------------------------------------------
# enable the relay role
MPC_RELAY_ENABLE=
# libp2p listen multiaddrs (comma-separated)
MPC_RELAY_LISTEN=
# private-network 32B swarm key (secret)
MPC_RELAY_PNET_PSK=
# self-sovereign trust anchor: wallet-group public key set, base64
# (capability-token verification anchor; relay verifies locally, no coord
# dependency). Comma-separated.
MPC_RELAY_TOKEN_VERIFY_GROUP_PUBKEYS=
# enable rendezvous (same-group member discovery)
MPC_RELAY_RENDEZVOUS_ENABLE=
# anti-DoS quota: reservations per token
MPC_RELAY_LIMITS_RESERVATION_PER_TOKEN=
# anti-DoS quota: reservations per group
MPC_RELAY_LIMITS_RESERVATION_PER_GROUP=
# per-connection bandwidth cap
MPC_RELAY_LIMITS_BANDWIDTH_PER_CONN=
# max lifetime of one circuit-v2 relayed link before reset (keygen-aware)
MPC_RELAY_LIMITS_CIRCUIT_MAX_DURATION=

# -- coord role ------------------------------------------------------------
# enable the coord role
MPC_COORD_ENABLE=
# external-service + member API listen address
MPC_COORD_HTTP_LISTEN=
# SQLite persistence DSN (secret)
MPC_COORD_DB_DSN=
# whole-DB encryption at rest; MUST stay true in production. Setting false is
# dev/test only and additionally requires ALLOW_INSECURE_DB=1 (see below).
MPC_COORD_DB_ENCRYPTION_ENABLE=
# inbound external-service API key (auth fixed to api_key, always required
# when coord is enabled, secret)
MPC_COORD_EXTERNAL_API_KEY=
# result-callback URL (fixed address, always required)
MPC_COORD_EXTERNAL_RESULT_URL=
# result-callback outbound auth (anti-forgery): set at least one of secret /
# api_key; when both are set, secret (HMAC-SHA256 over "<unix>.<raw body>")
# takes precedence. Outbound credentials are physically isolated from the
# inbound api_key above.
# secret: HMAC-SHA256 signing key (preferred — body-bound, replay-resistant,
#         secret)
MPC_COORD_EXTERNAL_RESULT_SECRET=
# api_key: fallback Bearer token (used only when secret is unset, secret)
MPC_COORD_EXTERNAL_RESULT_API_KEY=
# single fixed notify URL (coord only POSTs notification events; FCM/APNS etc.
# are handled by an external notification channel)
MPC_COORD_NOTIFY_URL=
# notify outbound auth (same dual mode as result: at least one of secret /
# api_key, secret takes precedence when both are set, secret)
MPC_COORD_NOTIFY_SECRET=
MPC_COORD_NOTIFY_API_KEY=
# clock-skew tolerance for expiry checks
MPC_COORD_TTL_SKEW_TOLERANCE=
# signer-subset selection policy: stable | liveness
MPC_COORD_QUORUM_SIGNER_SELECT=
# wait for signing completion after dispatch (must be < remaining TTL)
MPC_COORD_DISPATCH_TIMEOUT=

# -- dev/test only ---------------------------------------------------------
# Required only when coord.db.encryption.enable=false: must explicitly confirm
# a non-production environment, otherwise startup fail-closes. Never set in
# production/release (production iron-law guardrail, database.md §7.1).
# ALLOW_INSECURE_DB=1

# Note: the DB unlock passphrase is the absolute exception -- it must never go
# into .env / config files / CLI / KMS. It is supplied only via the admin-api
# unlock interaction, held in memory, and zeroed on re-lock (server.md C9b,
# database.md §7).
