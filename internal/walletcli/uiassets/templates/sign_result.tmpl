{{define "sign_result.tmpl"}}
<div id="sign-decision" class="card">
  {{if .OK}}
    <div class="badge badge-ok mb-2">{{if .Approved}}signed{{else}}rejected — completed cleanly{{end}}</div>
    {{if and .Approved .RSV}}
      <div class="text-sm text-slate-400 uppercase tracking-wide mb-2">{R,S,V} (hex, 65 bytes)</div>
      <pre class="font-mono text-xs break-all">{{.RSV}}</pre>
    {{end}}
  {{else}}
    <div class="badge badge-err mb-2">{{if .Approved}}sign failed{{else}}rejected with error{{end}}</div>
    <div class="text-sm"><span class="font-mono">{{.Code}}</span> — {{.Msg}}</div>
  {{end}}
  <p class="mt-3"><a class="text-sky-400 text-sm" href="/ui/sign">&larr; Back to pending list</a></p>
</div>
{{end}}
