{{define "transactions.tmpl"}}{{template "head" .}}{{template "nav" .}}
<h1 class="text-xl font-bold text-slate-100 mb-4">Transactions</h1>
<form class="flex flex-wrap gap-2 mb-4" hx-get="/admin/ui/transactions"
      hx-target="#tx-body" hx-select="#tx-body" hx-swap="outerHTML" hx-push-url="true">
  <input class="input" type="text" name="group" placeholder="group id" value="{{.F.group}}">
  <input class="input" type="text" name="proposer" placeholder="proposer" value="{{.F.proposer}}">
  <select class="input" name="status">
    <option value="">any status</option>
    {{$s := .F.status}}{{range .Statuses}}<option value="{{.}}" {{if eq . $s}}selected{{end}}>{{.}}</option>{{end}}
  </select>
  <button class="btn" type="submit">Filter</button>
  <span class="htmx-indicator text-slate-400 text-sm" style="align-self:center">loading…</span>
</form>
<div class="card overflow-x-auto">
  {{template "tx_rows.tmpl" .}}
</div>
{{template "foot" .}}{{end}}
