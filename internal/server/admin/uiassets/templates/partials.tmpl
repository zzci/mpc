{{define "head"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>admin-ui · {{.Active}}</title>
<link rel="stylesheet" href="/assets/tw.css">
<script src="/assets/htmx.min.js" defer></script>
</head>
<body class="min-h-screen">
<div class="mx-auto max-w-6xl p-6">{{end}}

{{define "nav"}}
<header class="flex items-center justify-between mb-6 border-b border-slate-700 py-3">
  <div class="flex items-center gap-3">
    <span class="text-xl font-bold text-slate-100">admin-ui</span>
    <span class="badge">read-only</span>
  </div>
  <nav class="flex gap-3 text-sm">
    <a href="/" class="{{if eq .Active "home"}}text-sky-400 font-semibold{{else}}text-slate-300{{end}}">Overview</a>
    <a href="/transactions" class="{{if eq .Active "tx"}}text-sky-400 font-semibold{{else}}text-slate-300{{end}}">Transactions</a>
    <a href="/audit" class="{{if eq .Active "audit"}}text-sky-400 font-semibold{{else}}text-slate-300{{end}}">Audit</a>
    <a href="/relay" class="{{if eq .Active "relay"}}text-sky-400 font-semibold{{else}}text-slate-300{{end}}">Relay</a>
    <a href="/pairing" class="{{if eq .Active "pairing"}}text-sky-400 font-semibold{{else}}text-slate-300{{end}}">Pairing</a>
    <form method="post" action="/logout" class="inline-flex"><button class="text-slate-400" type="submit">Sign out</button></form>
  </nav>
</header>{{end}}

{{define "foot"}}
<footer class="mt-6 text-xs text-slate-500 text-center">
  admin-ui · read-only inspection panel · control operations are not exposed here (admin.md §1/§3)
</footer>
</div>
</body>
</html>{{end}}
