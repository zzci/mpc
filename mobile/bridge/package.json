{
  "name": "@mcp/rn-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "React Native native-module bridge to the mcp gomobile device-signing SDK (mobileapi flat surface)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "McpWallet.podspec"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "codegenConfig": {
    "name": "McpWalletSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "cc.mcp.wallet.bridge"
    }
  }
}
