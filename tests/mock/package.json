{
  "name": "mock-extsvc",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Test-only external business service double for the TSS MPC wallet E2E (testing.md §3.1, MEXT-001). NOT a product service.",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "golden:regen": "cd .. && go run ./mock-extsvc/testdata/gen > mock-extsvc/testdata/golden.json"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "canonicalize": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "^1.3.14",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3"
  }
}
